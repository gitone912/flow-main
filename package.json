{
  "name": "flow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c magenta,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts",
    "preview": "vite preview --host 127.0.0.1",
    "test": "tsx --test test/*.test.ts",
    "data:sync": "tsx scripts/prepare-roster.ts",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:seed": "tsx -e \"import('./server/db.ts').then(async (m) => { for (const f of ['.env.local', '.env']) try { process.loadEnvFile(f) } catch {} ; console.log(await m.seedEmployees(true)) })\""
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/manrope": "^5.2.8",
    "@hono/node-server": "^1.19.19",
    "hono": "^4.13.19",
    "lucide-react": "^0.577.0",
    "pretendard": "^1.3.9",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^3.7.0",
    "tsx": "^4.21.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "concurrently": "^9.2.5",
    "postgres": "^3.4.5",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.9.3",
    "vite": "^8.0.0"
  },
  "engines": {
    "node": ">=22.12"
  }
}
