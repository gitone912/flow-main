# Flow API server (server/index.ts). Copy to .env and fill in one provider key.
PORT=3001

# groq | gemini | openai — without a key Flow uses its deterministic rule-based parser.
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LLM_TIMEOUT_MS=15000

# Optional: comma-separated allowed origins for a frontend hosted elsewhere (default: any).
CORS_ORIGINS=
# Optional, frontend build: API origin when the frontend is not served by `npm start`.
VITE_API_BASE_URL=

# Optional: max LLM-backed requests per client IP per minute (default 40).
AI_RATE_LIMIT_PER_MIN=40

# Optional: Supabase persistence (server-side). Leave empty to keep browser-only storage.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_DB_URL=
